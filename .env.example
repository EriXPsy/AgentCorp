# AgentCorp Environment Variables
# 复制为 .env 后按需填写。所有变量都有安全默认值，缺省时服务照常启动并降级。

# ======================================================================
# 1) 评测裁判后端（model-service，决定「是否能出真实分数」）
# ======================================================================
# mock  —— 不提供推理，调用方降级并明确标注 source=degraded（绝不伪造分数）
# http  —— 任意 OpenAI 兼容服务（阿里云百炼 / 火山方舟 / 自建 vLLM / OpenAI…）
# local —— 本机权重（transformers），设备见 DEVICE
JUDGE_BACKEND=http
JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_API_KEY=your_judge_api_key
JUDGE_MODEL=qwen-plus
JUDGE_MAX_TOKENS=1536
JUDGE_TIMEOUT=120

# ensemble 重复测量：k 次采样若全用温度 0，输出逐字相同，pass^k 会退化成复读。
# 第 0 次始终用温度 0 作为可复现基准，之后各次用下面这个温度真实重采样。
JUDGE_ENSEMBLE_TEMPERATURE=0.5
# 跨家族裁判池（逗号分隔）。配 ≥2 个不同家族的模型后，ensemble 第 i 次轮转到第 i 个，
# 这是对「自我增强偏差」唯一有效的结构性缓解：别让裁判总跟被评方同源。
# 例：JUDGE_MODELS=qwen-plus,deepseek-chat,glm-4-plus
JUDGE_MODELS=

# MOCK=true 时强制走内置 fixture 事件流（演示 / 联调用，不代表真实评测结论）
MOCK=false
# 复现控制：温度 0 = 可复现；ensemble 需要真实重复采样时可调到 0.3~0.7
TEMPERATURE=0.0
SEED=42
FRAME_SAMPLE=8

# 本机权重路径与设备（仅 JUDGE_BACKEND=local 时生效）
# DEVICE 支持 auto|cuda|cpu|npu；缺依赖 / 无设备时自动降级，不崩溃
DEVICE=auto
MODEL_PATH=models/MiniCPM-o-4_5-Q4_K_M.gguf

# 语音合成后端：auto|model|system|none（都不可用时只发文本，不发 audio 事件）
TTS_BACKEND=auto

# ===== 代码沙盒（真实执行 + 静态扫描）=====
# 默认关闭：它会在本机执行来自候选 agent 的代码，必须由部署者显式授权。
# 开启后 code 工种产出 verifiedEvidence，这是解除 Q6 权重折减的唯一途径。
SANDBOX_ENABLED=false
SANDBOX_TIMEOUT=10
SANDBOX_MEM_MB=512

# ======================================================================
# 2) 候选 Agent 跑题通道（把题面发给候选、取回作答）
# ======================================================================
# text    —— 直接使用调用方提供的答案文本（人工 / transcript 模式）
# gateway —— 经 OpenClaw gateway 的 OpenAI 兼容 chat 调度（真实跑题）
CANDIDATE_CHANNEL=text
GATEWAY_BASE_URL=
GATEWAY_MODEL=
GATEWAY_API_KEY=
CANDIDATE_TIMEOUT=120

# ======================================================================
# 3) 桌面端 / 网关
# ======================================================================
OPENCLAW_GATEWAY_PORT=18789
VITE_DEV_SERVER_PORT=5173

# 真实 LLM 执行后端（OpenAI 兼容端点）。
# 服务端（Vite dev 中间件）读取，不加 VITE_ 前缀因此绝不打进前端包。
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_MODEL=glm-5.3

# ======================================================================
# 3.5) 可选：华为昇腾（Ascend）OpenAI 兼容端点
# ======================================================================
# 适配 vLLM-Ascend / MindIE / 华为云 MaaS 暴露的 OpenAI 兼容端点。
# 配置后 UI（设置 → 模型与提供方 → 华为昇腾）与冒烟脚本 verify:ascend 均可用；
# 也可以直接把上面的 LLM_* 指向昇腾端点（二者等价，ASCEND_* 仅供冒烟脚本优先读取）。
# 注意：baseUrl 是 OpenAI 根端点，必须带 /v1 后缀。部署指南见 docs/ascend/deployment.md。
# ASCEND_BASE_URL=http://ascend-host:8000/v1
# ASCEND_API_KEY=your_ascend_api_key
# ASCEND_MODEL=deepseek-ai/DeepSeek-V3

# ======================================================================
# 4) 可选：跨用户点赞/青睐聚合（未配置时纯本地计数，功能不受影响）
# ======================================================================
# 仅允许 https（localhost 例外，便于本地联调）
AGENTCORP_REACTIONS_API=
AGENTCORP_REACTIONS_TOKEN=

# ======================================================================
# 5) 可选：匿名遥测（无 key 则完全不初始化，不发送任何数据）
# ======================================================================
POSTHOG_API_KEY=

# ======================================================================
# 6) Release / CI（仅打包签名时需要）
# ======================================================================
APPLE_ID=your@email.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX
CSC_LINK=path/to/certificate.p12
CSC_KEY_PASSWORD=certificate_password
GH_TOKEN=github_personal_access_token
