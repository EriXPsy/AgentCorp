# ============================================================
# AgentCorp .gitignore (merged)
# Base: AgentCorp Electron base + AgentCorp eval/Python additions.
# Kept AgentCorp's QA/marketplace/Python entries; added AgentCorp's
# Electron build/secrets entries. No credentials or build output
# are ever committed.
# ============================================================

# ===== 依赖 / 包管理器 =====
node_modules/
.pnp
.pnp.js
.pnpm-store/
.npm-cache/

# ===== 构建产物 =====
dist/
dist-web/
dist-electron/
release/
.vite/
build/
artifacts/
!docs/artifacts/
*.tsbuildinfo
*.local
coverage/
.cache/
.turbo/

# ===== 环境变量（含敏感配置，禁止上传；保留模板）=====
.env
.env.local
.env.*.local
# 注：.env.example 是有意保留的模板，可上传

# ===== Electron 打包产物 =====
*.dmg
*.exe
*.AppImage
*.deb
*.rpm
resources/bin

# ===== 密钥 / 证书（禁止上传）=====
*.p12
*.pem
*.key

# ===== 测试 / QA 构建产物（自动生成，无需入库）=====
scripts/qa/.engine.qa.bundle.mjs
scripts/qa/.github-import.qa.bundle.mjs
scripts/qa/.marketplace.qa.bundle.mjs
scripts/qa/_fesrc/
test-results/

# ===== 后端 Python 缓存 =====
model-service/.pytest_cache/
model-service/**/__pycache__/
model-service/pytest-cache-files-/

# ===== 临时目录 =====
tmp/
tmp-*.png
tmp-*.py
tmp_*.py
tmp_test.py
old.html
.tmp-test-tmp/

# ===== 日志 =====
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ===== 文档 / 工具缓存 =====
docs/pr-session-notes-*.md
# 商业与赛事材料仅保留本地，不入库
docs/strategy/
.cursor/
.superpowers/
.specstory/
.gstack/
.worktrees/
.golutra/
.claude/
/anthropic-ai-claude-code-*.tgz

# Layer3 可选 JSON 落盘（运行时生成，非源码）
convergence-store.json

# 基准实验运行时产出（不入仓；基准数据 small text 可入仓）
model-service/data/experiments/

# 模型权重（GGUF/transformers 全量，体积 GB 级，不入库）
model-service/models/

# Python 虚拟环境
model-service/.venv/

# 素材下载暂存目录（像素办公室素材来源，非源码）
_downloads/

# 本地工作目录：阶段性交付物汇总，不入仓
update/

# PPT 交付以 pptx 为准，PDF 由本地导出，不入仓
方案PPT/*.pdf
scripts/eval/squad-bench-results/
model-service/data/style_memory/
